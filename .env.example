# Absolute path to the Obsidian vault directory
VAULT_ABSOLUTE_PATH=C:\Users\YourName\Vault 78

# CLI tool for vault operations.
# The official Obsidian CLI (enabled from Obsidian desktop Settings → Community → CLI).
# Can also use:
#   powershell    - uses Get-Content / Set-Content / Add-Content + findstr for search
#   rg            - ripgrep (search only; read/write/append will error)
#   findstr       - Windows built-in (search only)
OBSIDIAN_CLI_COMMAND=obsidian
